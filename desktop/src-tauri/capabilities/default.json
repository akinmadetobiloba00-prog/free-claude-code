{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FCC Desk main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "allow-server-status",
    "allow-ensure-server",
    "allow-list-harnesses",
    "allow-launch-in-terminal",
    "allow-run-capture"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  }
}